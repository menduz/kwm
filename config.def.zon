.{
    // environment variables
    // used by processes spawned by kwm
    .env = .{
        // .{ "key", "value" },
    },

    // working direction of processes spawned by kwm
    .working_directory = .home,

    .startup_cmds = .{
        // .{ "swaybg", "-i", "/path/to/wallpaper" },
    },

    // null
    // or
    // .{ .name = []const u8, .size = u32 }
    .xcursor_theme = null,

    // ?u32
    // solid color background
    // note: set this to null if you use other wallpaper program like `swaybg`, orelse it will be covered by this and unable to see
    .background = 0x33000000,

    .bar = .{
        .show_default = true,
        // .top
        // .bottom
        .position = .top,

        // a fontconfig pattern for fcft
        // kwm uses "monospace" for the glyphs that this font does not have, for example braille
        .font = "Terminus:size=9",

        // minimum height in logical pixels, 0 to use the font height
        // the text is in the vertical center of the bar
        .min_height = 20,

        .scheme = .{
            .normal = .{
                .fg = 0xa1a1a1ff,
                .bg = 0x0e1419ff,
            },
            // the selected tag and the title of the focused output
            .select = .{
                .fg = 0xffffffff,
                .bg = 0x0e1419ff,
            },
        },

        // set null to disable tags part
        .tags = .{
            // tags show on bar
            .tags = .{ "1", "2", "3", "4", "5", "6", "7", "8", "9" },
            // text color of tags without windows, null to use the scheme color
            .empty_fg = 0x1d2023ff,

            // click callback
            // each part supports left/right/middle/side/extra/forward/back/task
            // set null to disable
            .click = .{
                // could use 0 there because it will be replace with the tag clicked
                .left = .{ .set_output_tag = .{ .tag = .{ .tag = 0 } } },
                .right = .{ .toggle_output_tag = .{ .mask = 0 } },
                .middle = .{ .toggle_window_tag = .{ .mask = 0 } },
            },
        },
        // set null to disable mode part
        .mode = .{
            // mode tags show on bar
            // display full mode string by default
            .tags = .{
                .{ "default", "" },         // hide mode tag in default mode
                .{ "passthrough", "P" },    // only show "P" on bar in passthrough mode
                .{ "floating", "F" },       // only show "F" on bar in floating mode
            },

            .click = .{
                .left = .{ .switch_mode = .{ .mode = "default" } },
            },
        },
        // set null to disable layout part
        .layout = .{
            // layout tags show on bar
            // {{?}} will be replaced with managed window count, when the count is 0, `?` will be used as replacement.
            // e.g. [{{{=}}], when managed window count > 0, [N] will be showed, else [=] will be showed
            .tags = .{
                .tile = .{
                    .left = "[]=",
                    .right = "=[]",
                    .top = "[^]",
                    .bottom = "[_]",
                },
                .grid = .{
                    .horizontal = "|+|",
                    .vertical = "|||",
                },
                .monocle = "[{{=}}]",
                .deck = .{
                    .left = "[{{D}}]=",
                    .right = "=[{{D}}]",
                    .top = "[{{D}}^]",
                    .bottom = "[{{D}}_]",
                },
                .scroller = "[==]",
                .centered_master = .{
                    .horizontal = "=[]=",
                    .vertical = "=[V]="
                },
                .float = "><>",
            },

            // a click goes to the next layout, a right click to the previous layout
            // the tooltip shows all layouts in this order
            // or switch between the last two layouts:
            // .left = .switch_to_previous_layout,
            .click = .{
                .left = .{ .cycle_layout = .{ .direction = .forward } },
                .right = .{ .cycle_layout = .{ .direction = .reverse } },
            },
        },
        // set null to disable title part
        .title = .{
            .click = .{
                .left = .{ .zoom = .{ .swap = false } },
            },
        },
        // set null to disable status part
        // e.g.
        // .status = .{
        //     .data = .{ .text = "^#ff0000ffk^#00ff00ffw^#0000ffffm" }, // .stdin or .{ .fifo = "fifo file path" }, could use ^#RGBA to switch text color, and use ^#! to switch back to default color
        //
        //     .click = .{
        //         .middle = .{ .spawn = .{ .argv = .{ "foot" } } },
        //     },
        // },
        // the widgets below take the place of the status text
        .status = null,

        // widgets in the center of the bar, at the right end, and at the right of the tray
        // (see src/config/widget.zig)
        // each widget takes the waybar click options: .on_click, .on_click_right,
        // .on_click_middle, .on_scroll_up and .on_scroll_down (shell commands)
        // script widgets read JSON lines with "text", "tooltip" and "class", as waybar custom
        // modules; the classes "warning" and "critical" give a color, "blink" flashes the widget
        // the kwm-* scripts are in contrib/, and zig build installs them
        .center = .{
            // a click starts btop
            .{ .memory = .{ .format = .braille, .on_click = "ghostty -e btop --preset 2 -u 100" } },
            .{ .clock = .{} },
            .{ .cpu = .{ .format = .braille, .on_click = "ghostty -e btop --preset 2 -u 100" } },
            // " ☕ " when a lock blocks sleep
            .{ .script = .{ .exec = "kwm-sleep-inhibit", .interval = 5000, .return_type = .json } },
            // a microphone and a camera that flash red while a program uses them;
            // the script writes a line for each change
            .{ .script = .{ .exec = "kwm-privacy", .interval = 0, .return_type = .json } },
        },
        .right = .{
            // shown on battery and while charging, % below 100%
            .{ .battery = .{ .warning = 20, .critical = 10 } },
            // shown at 80% used, in the critical color below 10 GB free
            .{ .disk = .{ .path = "/", .show = 80, .alert = 10000000000 } },
        },
        .end = .{
            // "●" for the notifications of dunst, the tooltip holds the last 10
            .{ .script = .{ .exec = "kwm-notifications", .interval = 5000, .return_type = .json } },
        },
        .widget_colors = .{
            .warning = 0xffb354ff,
            .critical = 0xff3333ff,
        },
        // milliseconds before the tooltip of a widget shows
        .tooltip_delay = 500,

        // the system tray (StatusNotifierItem), kwm must be built with -Dtray=true
        // set null to disable the tray
        .tray = .{
            .icon_size = 16, // logical pixels, 0: the height of the bar
            .spacing = 12,
            // the symbolic icons of this theme first, in the color of the text;
            // then the icons of the programs
            .icon_theme = "Adwaita",
            .show_passive = false,
            // color saturation of the icons: 1 colored, 0 grayscale, 0.1 = 90% gray and 10% color
            .saturation = 1.0,
            // the menus of the items: rows on stdin, the index of the chosen row on stdout
            // {title}: name of the item, {x} {y} {right}: place of the icon on its output
            // this rofi shows the menu at the top right corner, below the bar
            .menu_command = .{
                "rofi", "-dmenu", "-i", "-no-custom", "-format", "i", "-p", "{title}",
                "-show-icons", "-icon-theme", "Adwaita",
                "-theme-str", "window { location: north east; anchor: north east; x-offset: 0px; y-offset: {y}px; width: 360px; }",
            },
        },

        // override colors
        .override_colors = .{
            // areas:
            //      .tags
            //      .{ .mode = "floating" or other modes }, null will match all mode
            //      .{ layout = .tile or other layout }, null will match all layouts
            //      .title
            //      .status
            //
            // scheme is a struct, no need to specify all fields:
            //      .{
            //          .normal = .{
            //              .fg = u32,
            //              .bg = u32,
            //          },
            //          .select = .{
            //              .fg = u32,
            //              .bg = u32,
            //          }
            //      }
            //
            // mode, layout and status will only use the `normal` color
            // tags and title will use both `normal` and `select` color
            //
            // e.g. set scheme for mode tag:
            // .{
            //     .area = .{ .mode = null },
            //     .scheme = .{
            //         .normal = .{
            //             .fg = 0x444a73ff,
            //             .bg = 0xc8d3f5d0,
            //         }
            //     }
            // },
        }
    },

    .single_tagset = false,

    .sloppy_focus = true,

    // no gap at the edges of the output when one tiled window fills it,
    // and no gap in the monocle layout
    .smart_gaps = true,

    // .none
    // .on_focus_changed: warp cursor to the center of window focused
    // .on_output_changed: warp cursor to the center of output focused
    .cursor_warp = .none,

    // disable wrap around when iter focus or swap window in scroller layout
    .disable_wrap_around_for_scroller = false,

    // if to remember last floating geometry
    .remember_floating_geometry = false,

    .auto_swallow = false,

    // .top: stack top
    // .bottom: stack bottom
    // .stack_top: for tile and deck layout
    // .above_focused
    // .below_focused
    .default_attach_mode = .{
        .tile = .top,
        .grid = .top,
        .monocle = .top,
        .deck = .stack_top,
        .scroller = .below_focused,
        .centered_master = .top,
        .float = .top,
    },

    // .csd
    // .ssd
    .default_window_decoration = .ssd,

    // window border
    .border = .{
        .width = 2,
        .color = .{
            .focus = 0xf29718ff,
            .unfocus = 0x34373aff,
            .swallowing = 0xff3333ff,
        },
        // the space on each side between a tiled window with client side decorations
        // and its place in the layout; the frame of the client goes into it and into the
        // border; with .raised and a value more than 0, kwm draws only the outline around
        // such a window (a GTK frame of 4 pixels has its edges in a border of 3 with 2)
        .csd_margin = 0,
        // .flat: one color, drawn by river
        // .raised: the 3D window border of Windows 9x, drawn by kwm with the colors below;
        // a border of 3 pixels or more has an outline of 1 pixel outside the edges
        // (transparent: no outline); a window with client side decorations draws its
        // own frame, so kwm draws only the outline around it (refer to .csd_margin)
        .style = .flat,
        .raised = .{
            .focus = .{ .face = 0xc0c0c0ff, .highlight = 0xffffffff, .shadow = 0x808080ff, .frame = 0x000000ff, .outline = 0x000080ff },
            .unfocus = .{ .face = 0xc0c0c0ff, .highlight = 0xffffffff, .shadow = 0x808080ff, .frame = 0x000000ff, .outline = 0x00000000 },
            // read the colors above from the @define-color lines of gtk-3.0/gtk.css of the
            // current GTK theme (GTK_THEME at start); a color that the file lacks keeps the
            // value above; null to use only the values above
            .gtk_colors = .{
                .face = "bg_color",
                .highlight = "light_shadow",
                .shadow = "dark_shadow",
                .frame = "borders",
                .focus_outline = "wm_active_title",
                .unfocus_outline = null,
            },
        },
    },

    // .tile
    // .grid
    // .monocle
    // .deck
    // .scroller
    // .centered_master
    // .float
    .default_layout = .tile,
    .layout = .{
        .tile = .{
            .nmaster = 1,
            .mfact = 0.6,
            .inner_gap = 10,
            .outer_gap = 9,

            // .left
            // .right
            // .top
            // .bottom
            .master_location = .left,
        },
        .grid = .{
            .outer_gap = 9,
            .inner_gap = 12,

            // .horizontal
            // .vertical
            .direction = .horizontal,
        },
        .monocle = .{
            .gap = 9,
        },
        .deck = .{
            .nmaster = 1,
            .mfact = 0.55,
            .inner_gap = 12,
            .outer_gap = 9,

            // .left
            // .right
            // .top
            // .bottom
            .master_location = .left,
        },
        .scroller = .{
            .mfact = 0.5,
            .inner_gap = 16,
            .outer_gap = 9,
        },
        .centered_master = .{
            .nmaster = 1,
            .mfact = 0.55,
            .inner_gap = 12,
            .outer_gap = 9,

            // .horizontal
            // .vertical
            .direction = .horizontal,
        },
    },

    // key/pointer bindings
    .bindings = .{
        // repeat info for key repeat event, different with the repeat_info of input device
        .repeat_info = .{
            .rate = 100,
            .delay = 200,
        },

        // list of key bindings
        // full scheme:
        //       mode: string(< 16 bytes)
        //          "default" and "lock" are defined by default
        //          "default" is the default mode, if you not set `mode`, the binding will be seemed as "default" mode
        //          when the session locked, kwm will switch to "lock" mode
        //          you could define any other mode
        //       layout:
        //          xkb layout that should be used to translate key events for the purpose of triggering this key binding
        //          irrespective of the currently active xkb layout
        //          this field is a 0-indexed xkbcommon layout number for the keyboard that generated the key event
        //          by default this field is null so the currently active xkb layout of the keyboard that generated the key
        //          event will be used
        //       keysym: keysym string
        //       modifiers:
        //          a struct with fields: shift, ctrl, mod1, mod3, mod4, mod5, and all of these fields are `false` by default
        //          set modifiers to .{} means key binding without any modifier
        //       event: key binding trigger event
        //          there are two options:
        //              .event = .{
        //                  .repeat = action
        //              }
        //              after the key pressed, the action will repeatly trigger until key released or any another key pressed
        //
        //              .event = .{
        //                  .click = .{
        //                      .pressed = null or action, default is null
        //                      .released = null or action, default is null
        //                  }
        //              }
        //              the corrosponding action will only trigger once when key pressed or released
        //              the pressed action and released action could define at the same time
        .key = .{
            // windows
            .{ .keysym = "q", .modifiers = .{ .mod4 = true }, .event = .{ .click = .{ .pressed = .close } } },
            .{ .keysym = "space", .modifiers = .{ .mod4 = true, .shift = true }, .event = .{ .click = .{ .pressed = .toggle_floating } } },
            .{ .keysym = "f", .modifiers = .{ .mod4 = true, .shift = true }, .event = .{ .click = .{ .pressed = .{ .toggle_fullscreen = .{ .in_window = false } } } } },
            .{ .keysym = "Return", .modifiers = .{ .mod1 = true }, .event = .{ .click = .{ .pressed = .{ .zoom = .{ .swap = true } } } } },
            .{ .keysym = "j", .modifiers = .{ .mod4 = true }, .event = .{ .click = .{ .pressed = .{ .focus_iter = .{ .direction = .forward } } } } },
            .{ .keysym = "k", .modifiers = .{ .mod4 = true }, .event = .{ .click = .{ .pressed = .{ .focus_iter = .{ .direction = .reverse } } } } },
            .{ .keysym = "Up", .modifiers = .{ .mod4 = true }, .event = .{ .click = .{ .pressed = .{ .focus_iter = .{ .direction = .forward } } } } },
            .{ .keysym = "Down", .modifiers = .{ .mod4 = true }, .event = .{ .click = .{ .pressed = .{ .focus_iter = .{ .direction = .reverse } } } } },
            .{ .keysym = "j", .modifiers = .{ .mod4 = true, .shift = true }, .event = .{ .click = .{ .pressed = .{ .swap = .{ .direction = .forward } } } } },
            .{ .keysym = "k", .modifiers = .{ .mod4 = true, .shift = true }, .event = .{ .click = .{ .pressed = .{ .swap = .{ .direction = .reverse } } } } },
            .{ .keysym = "Up", .modifiers = .{ .mod4 = true, .shift = true }, .event = .{ .click = .{ .pressed = .{ .swap = .{ .direction = .forward } } } } },
            .{ .keysym = "Down", .modifiers = .{ .mod4 = true, .shift = true }, .event = .{ .click = .{ .pressed = .{ .swap = .{ .direction = .reverse } } } } },

            // the master area of the tile layout
            .{ .keysym = "h", .modifiers = .{ .mod4 = true }, .event = .{ .click = .{ .pressed = .{ .modify_mfact = .{ .change = .{ .step = -0.05 } } } } } },
            .{ .keysym = "l", .modifiers = .{ .mod4 = true }, .event = .{ .click = .{ .pressed = .{ .modify_mfact = .{ .change = .{ .step = 0.05 } } } } } },
            .{ .keysym = "h", .modifiers = .{ .mod4 = true, .shift = true }, .event = .{ .click = .{ .pressed = .{ .modify_nmaster = .{ .change = .increase } } } } },
            .{ .keysym = "l", .modifiers = .{ .mod4 = true, .shift = true }, .event = .{ .click = .{ .pressed = .{ .modify_nmaster = .{ .change = .decrease } } } } },

            // outputs
            .{ .keysym = "period", .modifiers = .{ .mod4 = true }, .event = .{ .click = .{ .pressed = .{ .focus_output_iter = .{ .direction = .forward } } } } },
            .{ .keysym = "comma", .modifiers = .{ .mod4 = true }, .event = .{ .click = .{ .pressed = .{ .focus_output_iter = .{ .direction = .reverse } } } } },
            .{ .keysym = "period", .modifiers = .{ .mod4 = true, .shift = true }, .event = .{ .click = .{ .pressed = .{ .send_to_output = .{ .direction = .forward } } } } },
            .{ .keysym = "comma", .modifiers = .{ .mod4 = true, .shift = true }, .event = .{ .click = .{ .pressed = .{ .send_to_output = .{ .direction = .reverse } } } } },
            // send the window to the next output, and go with it
            .{ .keysym = "o", .modifiers = .{ .mod4 = true }, .event = .{ .click = .{ .pressed = .{ .group = .{ .actions = .{ .{ .send_to_output = .{ .direction = .forward } }, .{ .focus_output_iter = .{ .direction = .forward } } } } } } } },

            // tags: Super+N shows tag N, Super+Shift+N moves the window to tag N,
            // Super+Ctrl+N adds or removes tag N on the output, Super+Ctrl+Shift+N on the window,
            // and Super+0 and Super+Shift+0 select all tags
            .{ .keysym = "0", .modifiers = .{ .mod4 = true }, .event = .{ .click = .{ .pressed = .{ .set_output_tag = .{ .tag = .{ .tag = 0b111111111 } } } } } },
            .{ .keysym = "0", .modifiers = .{ .mod4 = true, .shift = true }, .event = .{ .click = .{ .pressed = .{ .set_window_tag = .{ .tag = .{ .tag = 0b111111111 } } } } } },
            .{ .keysym = "1", .modifiers = .{ .mod4 = true }, .event = .{ .click = .{ .pressed = .{ .set_output_tag = .{ .tag = .{ .tag = 1 } } } } } },
            .{ .keysym = "1", .modifiers = .{ .mod4 = true, .shift = true }, .event = .{ .click = .{ .pressed = .{ .set_window_tag = .{ .tag = .{ .tag = 1 } } } } } },
            .{ .keysym = "1", .modifiers = .{ .mod4 = true, .ctrl = true }, .event = .{ .click = .{ .pressed = .{ .toggle_output_tag = .{ .mask = 1 } } } } },
            .{ .keysym = "1", .modifiers = .{ .mod4 = true, .ctrl = true, .shift = true }, .event = .{ .click = .{ .pressed = .{ .toggle_window_tag = .{ .mask = 1 } } } } },
            .{ .keysym = "2", .modifiers = .{ .mod4 = true }, .event = .{ .click = .{ .pressed = .{ .set_output_tag = .{ .tag = .{ .tag = 2 } } } } } },
            .{ .keysym = "2", .modifiers = .{ .mod4 = true, .shift = true }, .event = .{ .click = .{ .pressed = .{ .set_window_tag = .{ .tag = .{ .tag = 2 } } } } } },
            .{ .keysym = "2", .modifiers = .{ .mod4 = true, .ctrl = true }, .event = .{ .click = .{ .pressed = .{ .toggle_output_tag = .{ .mask = 2 } } } } },
            .{ .keysym = "2", .modifiers = .{ .mod4 = true, .ctrl = true, .shift = true }, .event = .{ .click = .{ .pressed = .{ .toggle_window_tag = .{ .mask = 2 } } } } },
            .{ .keysym = "3", .modifiers = .{ .mod4 = true }, .event = .{ .click = .{ .pressed = .{ .set_output_tag = .{ .tag = .{ .tag = 4 } } } } } },
            .{ .keysym = "3", .modifiers = .{ .mod4 = true, .shift = true }, .event = .{ .click = .{ .pressed = .{ .set_window_tag = .{ .tag = .{ .tag = 4 } } } } } },
            .{ .keysym = "3", .modifiers = .{ .mod4 = true, .ctrl = true }, .event = .{ .click = .{ .pressed = .{ .toggle_output_tag = .{ .mask = 4 } } } } },
            .{ .keysym = "3", .modifiers = .{ .mod4 = true, .ctrl = true, .shift = true }, .event = .{ .click = .{ .pressed = .{ .toggle_window_tag = .{ .mask = 4 } } } } },
            .{ .keysym = "4", .modifiers = .{ .mod4 = true }, .event = .{ .click = .{ .pressed = .{ .set_output_tag = .{ .tag = .{ .tag = 8 } } } } } },
            .{ .keysym = "4", .modifiers = .{ .mod4 = true, .shift = true }, .event = .{ .click = .{ .pressed = .{ .set_window_tag = .{ .tag = .{ .tag = 8 } } } } } },
            .{ .keysym = "4", .modifiers = .{ .mod4 = true, .ctrl = true }, .event = .{ .click = .{ .pressed = .{ .toggle_output_tag = .{ .mask = 8 } } } } },
            .{ .keysym = "4", .modifiers = .{ .mod4 = true, .ctrl = true, .shift = true }, .event = .{ .click = .{ .pressed = .{ .toggle_window_tag = .{ .mask = 8 } } } } },
            .{ .keysym = "5", .modifiers = .{ .mod4 = true }, .event = .{ .click = .{ .pressed = .{ .set_output_tag = .{ .tag = .{ .tag = 16 } } } } } },
            .{ .keysym = "5", .modifiers = .{ .mod4 = true, .shift = true }, .event = .{ .click = .{ .pressed = .{ .set_window_tag = .{ .tag = .{ .tag = 16 } } } } } },
            .{ .keysym = "5", .modifiers = .{ .mod4 = true, .ctrl = true }, .event = .{ .click = .{ .pressed = .{ .toggle_output_tag = .{ .mask = 16 } } } } },
            .{ .keysym = "5", .modifiers = .{ .mod4 = true, .ctrl = true, .shift = true }, .event = .{ .click = .{ .pressed = .{ .toggle_window_tag = .{ .mask = 16 } } } } },
            .{ .keysym = "6", .modifiers = .{ .mod4 = true }, .event = .{ .click = .{ .pressed = .{ .set_output_tag = .{ .tag = .{ .tag = 32 } } } } } },
            .{ .keysym = "6", .modifiers = .{ .mod4 = true, .shift = true }, .event = .{ .click = .{ .pressed = .{ .set_window_tag = .{ .tag = .{ .tag = 32 } } } } } },
            .{ .keysym = "6", .modifiers = .{ .mod4 = true, .ctrl = true }, .event = .{ .click = .{ .pressed = .{ .toggle_output_tag = .{ .mask = 32 } } } } },
            .{ .keysym = "6", .modifiers = .{ .mod4 = true, .ctrl = true, .shift = true }, .event = .{ .click = .{ .pressed = .{ .toggle_window_tag = .{ .mask = 32 } } } } },
            .{ .keysym = "7", .modifiers = .{ .mod4 = true }, .event = .{ .click = .{ .pressed = .{ .set_output_tag = .{ .tag = .{ .tag = 64 } } } } } },
            .{ .keysym = "7", .modifiers = .{ .mod4 = true, .shift = true }, .event = .{ .click = .{ .pressed = .{ .set_window_tag = .{ .tag = .{ .tag = 64 } } } } } },
            .{ .keysym = "7", .modifiers = .{ .mod4 = true, .ctrl = true }, .event = .{ .click = .{ .pressed = .{ .toggle_output_tag = .{ .mask = 64 } } } } },
            .{ .keysym = "7", .modifiers = .{ .mod4 = true, .ctrl = true, .shift = true }, .event = .{ .click = .{ .pressed = .{ .toggle_window_tag = .{ .mask = 64 } } } } },
            .{ .keysym = "8", .modifiers = .{ .mod4 = true }, .event = .{ .click = .{ .pressed = .{ .set_output_tag = .{ .tag = .{ .tag = 128 } } } } } },
            .{ .keysym = "8", .modifiers = .{ .mod4 = true, .shift = true }, .event = .{ .click = .{ .pressed = .{ .set_window_tag = .{ .tag = .{ .tag = 128 } } } } } },
            .{ .keysym = "8", .modifiers = .{ .mod4 = true, .ctrl = true }, .event = .{ .click = .{ .pressed = .{ .toggle_output_tag = .{ .mask = 128 } } } } },
            .{ .keysym = "8", .modifiers = .{ .mod4 = true, .ctrl = true, .shift = true }, .event = .{ .click = .{ .pressed = .{ .toggle_window_tag = .{ .mask = 128 } } } } },
            .{ .keysym = "9", .modifiers = .{ .mod4 = true }, .event = .{ .click = .{ .pressed = .{ .set_output_tag = .{ .tag = .{ .tag = 256 } } } } } },
            .{ .keysym = "9", .modifiers = .{ .mod4 = true, .shift = true }, .event = .{ .click = .{ .pressed = .{ .set_window_tag = .{ .tag = .{ .tag = 256 } } } } } },
            .{ .keysym = "9", .modifiers = .{ .mod4 = true, .ctrl = true }, .event = .{ .click = .{ .pressed = .{ .toggle_output_tag = .{ .mask = 256 } } } } },
            .{ .keysym = "9", .modifiers = .{ .mod4 = true, .ctrl = true, .shift = true }, .event = .{ .click = .{ .pressed = .{ .toggle_window_tag = .{ .mask = 256 } } } } },

            // passthrough: Super+F11 sends all other keys to the focused window,
            // for example a nested compositor or a virtual machine
            .{ .keysym = "F11", .modifiers = .{ .mod4 = true }, .event = .{ .click = .{ .pressed = .{ .switch_mode = .{ .mode = "passthrough" } } } } },
            .{ .mode = "passthrough", .keysym = "F11", .modifiers = .{ .mod4 = true }, .event = .{ .click = .{ .pressed = .{ .switch_mode = .{ .mode = "default" } } } } },

            // programs
            .{ .keysym = "Return", .modifiers = .{ .mod4 = true }, .event = .{ .click = .{ .pressed = .{ .spawn_shell = .{ .cmd = "ghostty" } } } } },
            .{ .keysym = "Return", .modifiers = .{ .mod4 = true, .shift = true }, .event = .{ .click = .{ .pressed = .{ .spawn_shell = .{ .cmd = "ghostty --font-family=Terminus --font-family-bold=Terminus --font-family-italic=Terminus" } } } } },
            .{ .keysym = "space", .modifiers = .{ .mod4 = true }, .event = .{ .click = .{ .pressed = .{ .spawn_shell = .{ .cmd = "rofi -combi-modi drun -show combi -show-icons" } } } } },
            .{ .keysym = "c", .modifiers = .{ .mod4 = true, .shift = true }, .event = .{ .click = .{ .pressed = .{ .spawn_shell = .{ .cmd = "rofi -modi calc -show calc" } } } } },
            .{ .keysym = "e", .modifiers = .{ .mod4 = true }, .event = .{ .click = .{ .pressed = .{ .spawn_shell = .{ .cmd = "thunar" } } } } },
            .{ .keysym = "f", .modifiers = .{ .mod4 = true }, .event = .{ .click = .{ .pressed = .{ .spawn_shell = .{ .cmd = "brave" } } } } },
            .{ .keysym = "p", .modifiers = .{ .mod4 = true }, .event = .{ .click = .{ .pressed = .{ .spawn_shell = .{ .cmd = "wdisplays" } } } } },
            .{ .keysym = "p", .modifiers = .{ .mod4 = true, .shift = true }, .event = .{ .click = .{ .pressed = .{ .spawn_shell = .{ .cmd = "kanshictl reload" } } } } },
            .{ .keysym = "q", .modifiers = .{ .mod4 = true, .ctrl = true }, .event = .{ .click = .{ .pressed = .{ .spawn_shell = .{ .cmd = "loginctl lock-session" } } } } },

            // media keys, also when the session is locked
            .{ .keysym = "XF86AudioRaiseVolume", .modifiers = .{}, .event = .{ .click = .{ .pressed = .{ .spawn_shell = .{ .cmd = "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+" } } } } },
            .{ .keysym = "XF86AudioLowerVolume", .modifiers = .{}, .event = .{ .click = .{ .pressed = .{ .spawn_shell = .{ .cmd = "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-" } } } } },
            .{ .keysym = "XF86AudioMute", .modifiers = .{}, .event = .{ .click = .{ .pressed = .{ .spawn_shell = .{ .cmd = "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle" } } } } },
            .{ .keysym = "XF86AudioPlay", .modifiers = .{}, .event = .{ .click = .{ .pressed = .{ .spawn_shell = .{ .cmd = "playerctl play-pause" } } } } },
            .{ .keysym = "XF86AudioMedia", .modifiers = .{}, .event = .{ .click = .{ .pressed = .{ .spawn_shell = .{ .cmd = "playerctl play-pause" } } } } },
            .{ .keysym = "XF86AudioNext", .modifiers = .{}, .event = .{ .click = .{ .pressed = .{ .spawn_shell = .{ .cmd = "playerctl next" } } } } },
            .{ .keysym = "XF86AudioPrev", .modifiers = .{}, .event = .{ .click = .{ .pressed = .{ .spawn_shell = .{ .cmd = "playerctl previous" } } } } },
            .{ .keysym = "XF86MonBrightnessUp", .modifiers = .{}, .event = .{ .click = .{ .pressed = .{ .spawn_shell = .{ .cmd = "brightnessctl set +5%" } } } } },
            .{ .keysym = "XF86MonBrightnessDown", .modifiers = .{}, .event = .{ .click = .{ .pressed = .{ .spawn_shell = .{ .cmd = "brightnessctl set 5%-" } } } } },
            .{ .mode = "lock", .keysym = "XF86AudioRaiseVolume", .modifiers = .{}, .event = .{ .click = .{ .pressed = .{ .spawn_shell = .{ .cmd = "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+" } } } } },
            .{ .mode = "lock", .keysym = "XF86AudioLowerVolume", .modifiers = .{}, .event = .{ .click = .{ .pressed = .{ .spawn_shell = .{ .cmd = "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-" } } } } },
            .{ .mode = "lock", .keysym = "XF86AudioMute", .modifiers = .{}, .event = .{ .click = .{ .pressed = .{ .spawn_shell = .{ .cmd = "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle" } } } } },
            .{ .mode = "lock", .keysym = "XF86AudioPlay", .modifiers = .{}, .event = .{ .click = .{ .pressed = .{ .spawn_shell = .{ .cmd = "playerctl play-pause" } } } } },
            .{ .mode = "lock", .keysym = "XF86AudioMedia", .modifiers = .{}, .event = .{ .click = .{ .pressed = .{ .spawn_shell = .{ .cmd = "playerctl play-pause" } } } } },
            .{ .mode = "lock", .keysym = "XF86AudioNext", .modifiers = .{}, .event = .{ .click = .{ .pressed = .{ .spawn_shell = .{ .cmd = "playerctl next" } } } } },
            .{ .mode = "lock", .keysym = "XF86AudioPrev", .modifiers = .{}, .event = .{ .click = .{ .pressed = .{ .spawn_shell = .{ .cmd = "playerctl previous" } } } } },
            .{ .mode = "lock", .keysym = "XF86MonBrightnessUp", .modifiers = .{}, .event = .{ .click = .{ .pressed = .{ .spawn_shell = .{ .cmd = "brightnessctl set +5%" } } } } },
            .{ .mode = "lock", .keysym = "XF86MonBrightnessDown", .modifiers = .{}, .event = .{ .click = .{ .pressed = .{ .spawn_shell = .{ .cmd = "brightnessctl set 5%-" } } } } },
            .{ .mode = "lock", .keysym = "p", .modifiers = .{ .mod4 = true, .shift = true }, .event = .{ .click = .{ .pressed = .{ .spawn_shell = .{ .cmd = "kanshictl reload" } } } } },

            // other actions, e.g.
            // .{ .keysym = "r", .modifiers = .{ .mod4 = true, .shift = true }, .event = .{ .click = .{ .pressed = .reload_config } } },
            // .{
            //     .keysym = "q",
            //     .modifiers = .{ .mod4 = true, .shift = true },
            //     .event = .{
            //         .click = .{
            //             .pressed = .{
            //                 .quit = .{
            //                     .exit_session = true,
            //                     // command to run before quit
            //                     // will quit only when the process exit with zero status
            //                     // e.g. .{ "sh", "-c", "~/cleanup.sh" }
            //                     .hook = null,
            //                 },
            //             },
            //         },
            //     },
            // },
        },

        // list of pointer bindings
        // full scheme:
        //       mode: same as key binding
        //       button: pointer button
        //          .left
        //          .right
        //          .middle
        //       modifiers: same as key binding
        //       event: pointer binding trigger event
        //              .event = .{
        //                  .pressed = null or action, default is null
        //                  .released = null or action, default is null
        //              }
        //              the corrosponding action will only trigger once when pointer button pressed or released
        //              the pressed action and released action could define at the same time
        .pointer = .{
            .{
                .mode = "default",
                .button = .left,
                .modifiers = .{ .mod4 = true },
                .event = .{ .pressed = .pointer_move },
            },
            .{
                .mode = "default",
                .button = .right,
                .modifiers = .{ .mod4 = true },
                .event = .{ .pressed = .pointer_resize },
            },
        },
        // other unmentioned actions:
        //      group: run multiple actions in sequence
        //         .event = .{
        //             .click = .{
        //                 .pressed = .{
        //                     .group = .{
        //                         .actions = .{
        //                             action1,
        //                             action2,
        //                             ...
        //                         },
        //                     },
        //                 },
        //             },
        //         }
    },

    // rule part
    //
    // a rule pattern has fields below:
    //      str: pattern string, required
    //      regex: bool, if enable regex
    //      match_null: bool, if match null
    //
    // only the first rule matched will be applied

    // window rules
    // full scheme:
    //      app_id: rule pattern
    //      title: rule pattern
    //
    //      tag: window tag
    //      output: output name pattern, same as rule pattern
    //      floating: bool, if floating
    //      dimension: .{ .width = i32, .height = i32 }, initial dimension
    //      decoration: .csd or .ssd, window decoration
    //      is_terminal: bool, if set true, means the window could be swallowed
    //      disable_swallow: bool, if set true, the window could not swallow any other windows
    //      scroller_mfact: f32, initial mfact of the window for scroller layout
    //      attach_mode: like `default_attach_mode`, change attach_mode for window matched
    .window_rules = .{
        .{ .app_id = .{ .str = "org.keepassxc.KeePassXC" }, .floating = true },
        .{ .app_id = .{ .str = "opensnitch_ui" }, .floating = true },
        // the passphrase prompt of pinentry-gnome3 and of the GNOME keyring; its fixed size
        // comes after the first layout, thus without this rule it shows tiled for an instant
        .{ .app_id = .{ .str = "gcr-prompter" }, .floating = true },
        // e.g. ghostty --title=FloatingTerminal
        .{ .title = .{ .str = "FloatingTerminal" }, .floating = true },
    },

    // output rules
    // full scheme:
    //      name: rule pattern
    //
    //      presentation_mode: presentation mode, .vsync or .async
    //      layout: same as `layout` before but you only need to specify the values you want to change
    //      default_layout: same as `default_layout` before
    .output_rules = .{
        //
    },
}
